# Copie para .env.local (não versionado) e defina a senha.
POSTGRES_USER=flowdoc
POSTGRES_PASSWORD=
POSTGRES_DB=flowdoc
POSTGRES_PORT=5433

# Execução local sem Docker (npm run dev). Codifique caracteres especiais da senha na URL.
DATABASE_URL=postgresql://flowdoc:SUA_SENHA@127.0.0.1:5433/flowdoc

# Opcionais
# EMAIL_PROVIDER=mock   # mock apenas registra os e-mails de aviso de deploy no log
# API_PORT=3001
# WEB_PORT=3000
# DOCKER_DATABASE_URL=   # substitui a URL montada para o contêiner da aplicação
# OAUTH2_ISSUER=
# OAUTH2_CLIENTID=
# OAUTH2_REDIRECT_URI=
# OAUTH2_SCOPE=
