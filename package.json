{
  "name": "flowdoc",
  "private": true,
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx server/main.ts",
    "dev:web": "vite --port 3000 --strictPort",
    "test:postgres": "node --env-file-if-exists=.env --env-file-if-exists=.env.local tests/run-postgres.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "concurrently --kill-others \"npm:start:api\" \"npm:start:web\"",
    "start:api": "node --import tsx server/main.ts",
    "start:web": "vite preview",
    "docker:up": "docker compose --env-file .env.local up -d --build",
    "docker:down": "docker compose --env-file .env.local down"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "@xyflow/react": "^12.4.4",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "jose": "^6.1.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.3",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "prisma": "6.12.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
