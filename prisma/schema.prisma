generator client {
  provider = "prisma-client-js"
}

enum ProjectRevisionStatus {
  APPROVED
  REJECTED
  CANCELLED
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String            @id @default(uuid())
  email                    String            @unique
  name                     String
  role                     Role              @default(USER)
  identities               Identity[]
  projectProposals         ProjectProposal[] @relation("ProjectProposalAuthor")
  editedProjectProposals   ProjectProposal[] @relation("ProjectProposalEditor")
  authoredProjectRevisions ProjectRevision[] @relation("ProjectRevisionAuthor")
  reviewedProjectRevisions ProjectRevision[] @relation("ProjectRevisionReviewer")
  projectApprovers         ProjectApprover[]
}

model Identity {
  issuer  String
  subject String
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([issuer, subject])
}

enum Role {
  ADM
  DIGITAL
  DEV
  USER
  APPROVER
}

model Project {
  id        String            @id
  data      Json
  updatedAt DateTime          @updatedAt
  sprints   SprintProject[]
  tasks     Task[]
  proposal  ProjectProposal?
  history   ProjectRevision[]
  approvers ProjectApprover[]
}

model ProjectApprover {
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model ProjectProposal {
  id          String   @id @default(uuid())
  projectId   String   @unique
  data        Json
  changes     Json
  authorId    String
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author      User     @relation("ProjectProposalAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  updatedBy   User     @relation("ProjectProposalEditor", fields: [updatedById], references: [id], onDelete: Restrict)
}

model ProjectRevision {
  id         String                @id @default(uuid())
  projectId  String
  snapshot   Json
  changes    Json
  status     ProjectRevisionStatus
  authorId   String
  reviewerId String?
  createdAt  DateTime              @default(now())
  reviewedAt DateTime?
  project    Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author     User                  @relation("ProjectRevisionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reviewer   User?                 @relation("ProjectRevisionReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
}

model Sprint {
  id           String          @id @default(uuid())
  name         String
  nameFold     String
  objective    String
  startDate    String
  endDate      String
  projects     SprintProject[]
  participants Participant[]

  @@index([startDate, name, id])
}

model SprintProject {
  sprintId  String
  projectId String
  sprint    Sprint  @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([sprintId, projectId])
  @@index([projectId, sprintId])
}

model Team {
  id          String  @id @default(uuid())
  name        String
  description String
  staff       Staff[]
}

model Staff {
  id           String        @id @default(uuid())
  name         String
  email        String?       @unique
  teamId       String
  team         Team          @relation(fields: [teamId], references: [id], onDelete: Restrict)
  participants Participant[]
}

model Participant {
  id           String @id @default(uuid())
  sprintId     String
  staffId      String
  totalMinutes BigInt
  sprint       Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  staff        Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  tasks        Task[]

  @@unique([sprintId, staffId])
}

model Task {
  id             String      @id @default(uuid())
  participantId  String
  projectId      String
  featureId      String?
  taskNumber     BigInt
  title          String
  devOpsUrl      String?
  plannedMinutes BigInt?
  actualMinutes  BigInt?
  lessons        String
  challenges     String
  reviewNotes    String
  deployDate     String?
  participant    Participant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([participantId])
  @@index([projectId, featureId])
}
